# --- Секреты ---
# cookies Apple Music = доступ к аккаунту.
# Шаблон со звёздочкой покрывает cookies.txt.bak и прочие копии.
cookies*
*.cookies.txt
.env

# --- Состояние на сервере ---
# whitelist.json меняет сам бот командой /adduser. Пока файл был в репозитории,
# каждый деплой делал git reset --hard и откатывал добавленных пользователей.
whitelist.json

# --- Скачанная музыка ---
# Прежний шаблон Qobuz_Downloads/ не совпадал с реальным путём Qobuz/Downloads,
# поэтому скачанные файлы попадали в git как untracked.
Qobuz/Downloads/
AppleMusic/Downloads/
Spotify/Downloads/
Qobuz_Downloads/

# --- Окружения ---
venv/
# отдельное окружение gamdl: конфликтует с зависимостями бота
gamdl-venv/

# --- Прочее ---
__pycache__/
*.pyc
# кэш токена spotipy: пишется в каталог запуска
.cache
*.cache
*.bak
*.bak-*
logs/
bot.log
repomix-output.xml
